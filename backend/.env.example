# Variables del backend. Copiar a un .env en la raíz del repo (docker compose lo lee) o exportarlas.
# Nunca subir el .env real: está en .gitignore.
DATABASE_URL=postgresql://tm_user:tm_pass@localhost:5432/tm_scorekeeper
FRONTEND_URL=http://localhost:5173

# Autenticación (D-03). Sin las tres primeras el login responde 503 y la API rechaza todo salvo /health.
AUTH_USERNAME=
# cd backend && python -m scripts.hash_password
# Entre comillas simples: el hash tiene '$' y docker compose / la shell los expandirían.
AUTH_PASSWORD_HASH=''
# 32+ caracteres: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Opcional (30 por defecto)
AUTH_TOKEN_TTL_DAYS=30

# Header X-Admin-Secret de POST /admin/recompute
ADMIN_SECRET=

# Proxies propios delante del backend (Render: 1). 0 = usar la IP de la conexión.
TRUSTED_PROXY_HOPS=0
